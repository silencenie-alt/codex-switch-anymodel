# codex-switch-anymodel 配置

# 上游 API 密钥（必需）
api_key=sk-your-api-key

# 上游 API 基础地址
# 默认: https://api.deepseek.com
# 示例: https://api.openai.com
# 示例: https://api.anthropic.com  (需第三方兼容层)
base_url=https://api.deepseek.com

# 默认模型名称
# 当 Codex CLI 未指定模型或使用 gpt-* 时使用的模型
model=deepseek-chat

# 本地代理服务监听地址
host=127.0.0.1

# 本地代理服务监听端口
port=11435

# 日志级别: DEBUG, INFO, WARNING, ERROR
log_level=INFO

# 日志文件路径
log_file=logs/proxy.log

# 日志保留时间
log_retention=30 days

# 上游 API 请求超时时间（秒）
request_timeout=300